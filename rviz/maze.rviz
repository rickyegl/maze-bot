Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: maze
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.3
      Plane Cell Count: 10
      Color: 160; 160; 164
      Offset:
        X: 0.15
        Y: 0.15
        Z: 0
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Marker Scale: 0.3
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        Depth: 5
      Size (m): 0.015
      Style: Spheres
      Color Transformer: FlatColor
      Color: 255; 90; 0
    - Class: rviz_default_plugins/MarkerArray
      Name: Detected walls
      Enabled: true
      Topic:
        Value: /maze/wall_markers
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 5
    - Class: rviz_default_plugins/Marker
      Name: Target cell
      Enabled: true
      Topic:
        Value: /explorer/goal
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 5
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: false
      Topic:
        Value: /odom
      Keep: 100
      Shape:
        Shaft Length: 0.1
        Head Length: 0.05
    - Class: rviz_default_plugins/Image
      Name: Front camera
      Enabled: true
      Topic:
        Value: /camera/image_raw
        Reliability Policy: Best Effort
        Depth: 2
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.5
      Pitch: 1.2
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
